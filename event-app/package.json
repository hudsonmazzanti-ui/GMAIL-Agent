{
  "name": "event-app",
  "version": "0.1.0",
  "private": true,
  "description": "In-house TCG event runner: registration, check-in, Swiss pairings, standings and top cut over the local network.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fake-pos": "tsx scripts/fake-pos.ts",
    "serve:fake-pos": "POS_OAUTH_URL=http://localhost:4545 POS_PRODUCTS_URL=http://localhost:4545 POS_PURCHASES_URL=http://localhost:4545 tsx server/index.ts",
    "build:demo": "vite build --config vite.demo.config.ts --mode demo"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0",
    "qrcode-generator": "^1.4.4",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@fastify/formbody": "^8.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sql.js": "^1.12.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.8"
  }
}
